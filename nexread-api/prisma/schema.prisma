// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum LoanStatus {
  ACTIVE
  RETURNED
}

enum AdminAuditAction {
  USER_ROLE_CHANGED
  USER_DELETED
}

model User {
  id                 Int             @id @default(autoincrement())
  fullName           String
  email              String          @unique
  password           String
  role               Role            @default(USER)
  refreshTokenHash   String?
  tokenVersion       Int             @default(0)
  loans              Loan[]
  reviews            Review[]
  cartItems          CartItem[]
  adminActions       AdminAuditLog[] @relation("AdminAuditActor")
  adminActionTargets AdminAuditLog[] @relation("AdminAuditTarget")
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([deletedAt])
}

model AdminAuditLog {
  id           Int              @id @default(autoincrement())
  actorAdminId Int
  targetUserId Int
  action       AdminAuditAction
  previousRole Role?
  newRole      Role?
  actorAdmin   User             @relation("AdminAuditActor", fields: [actorAdminId], references: [id], onDelete: Restrict)
  targetUser   User             @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())

  @@index([actorAdminId])
  @@index([targetUserId])
  @@index([createdAt])
}

model Author {
  id                 String    @id
  name               String    @unique
  booksCount         Int       @default(0)
  borrowedBooksCount Int       @default(0)
  rating             Float     @default(0)
  avatarPath         String?
  deletedAt          DateTime?
  books              Book[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([deletedAt])
}

model Category {
  id        String   @id
  name      String   @unique
  slug      String   @unique
  subtitle  String?
  iconPath  String?
  books     Book[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id              String     @id
  title           String
  rating          Float      @default(0)
  coverClassName  String?
  authorId        String
  categoryId      String
  isAvailable     Boolean    @default(true)
  totalCopies     Int        @default(1)
  availableCopies Int        @default(1)
  deletedAt       DateTime?
  author          Author     @relation(fields: [authorId], references: [id])
  category        Category   @relation(fields: [categoryId], references: [id])
  loans           Loan[]
  reviews         Review[]
  cartItems       CartItem[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([deletedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    String
  rating    Int
  comment   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
}

model Loan {
  id         Int        @id @default(autoincrement())
  userId     Int
  bookId     String
  status     LoanStatus @default(ACTIVE)
  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  book       Book       @relation(fields: [bookId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}
